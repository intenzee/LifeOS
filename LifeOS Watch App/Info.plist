<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). Keys the
	     generator can't express live here. -->
	<!-- WCH-15: complications open lifeos://watch/… links (WatchRootView). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tanmay.LifeOS.watchkitapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lifeos</string>
			</array>
		</dict>
	</array>
	<key>WKBackgroundModes</key>
	<array>
		<!-- HKWorkoutSession keeps the app running wrist-down (WCH-12/13). -->
		<string>workout-processing</string>
	</array>
</dict>
</plist>
